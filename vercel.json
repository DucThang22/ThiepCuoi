{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/trang-thang", "destination": "/trang-thang.html" },
    { "source": "/Trang-Thang", "destination": "/trang-thang.html" },
    { "source": "/trangthang", "destination": "/trang-thang.html" },
    { "source": "/nha-gai", "destination": "/trang-thang.html" },
    { "source": "/nhagai", "destination": "/trang-thang.html" },
    { "source": "/gui-huy", "destination": "/gui-huy.html" },
    { "source": "/Gui-Huy", "destination": "/gui-huy.html" },
    { "source": "/huy", "destination": "/gui-huy.html" },
    { "source": "/guihuy", "destination": "/gui-huy.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
